# =============================================================================
# SidrahSoft Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values for your environment.
#
# PRODUCTION DEPLOYMENT:
#   - Do NOT copy the development .env to production.
#   - Set all values via the platform's environment variable management
#     (Railway variables, Sidrah Server environment, etc.).
#   - All production values must be different from development values.
#   - Run: python manage.py check --deploy
# =============================================================================

# Django core settings
# Railway / production variable names use the DJANGO_ prefix.
# Non-prefixed names are still accepted for backward compatibility.
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Approved local development ports: 5174-5178 (Vite auto-increments when the default port is in use).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176,http://localhost:5177,http://127.0.0.1:5177,http://localhost:5178,http://127.0.0.1:5178
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176,http://localhost:5177,http://127.0.0.1:5177,http://localhost:5178,http://127.0.0.1:5178


# Django admin URL path (non-default for security through obscurity).
# Change this to a non-obvious path in production.
# Default: sidrah-management/
DJANGO_ADMIN_URL=sidrah-management/

# Public site URL for certificate verification links and QR codes.
# MUST be set to the production HTTPS domain in production.
# Example: https://sidrahsoft.com
PUBLIC_SITE_URL=http://localhost:5174

# Cross-origin cookie handling.
# Use 'None' for production when the frontend and backend are on different origins.
# 'None' requires Secure=True, which is enabled automatically in non-DEBUG mode.
DJANGO_SESSION_COOKIE_SAMESITE=None
DJANGO_CSRF_COOKIE_SAMESITE=None

# HTTPS redirect. Default is True in production. Set to False on Railway because the
# edge terminates HTTPS and internal healthchecks reach the container over HTTP.
DJANGO_SECURE_SSL_REDIRECT=True

# Railway / Heroku PostgreSQL connection string.
# When set, this overrides the local DB_* variables below.
# PRODUCTION: Use a strong, randomly generated password (32+ characters).
DATABASE_URL=

# Local PostgreSQL settings (used when DATABASE_URL is absent).
DB_NAME=sidrahsoft_db
DB_USER=sidrahsoft_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ar

MEDIA_URL=/media/
STATIC_URL=/static/

# Session cookie age in seconds (default: 28800 = 8 hours)
SESSION_COOKIE_AGE=28800

# Email configuration
# For local development, console backend prints emails to the terminal.
# For production, use django.core.mail.backends.smtp.EmailBackend and provide
# EMAIL_HOST, EMAIL_HOST_USER, and EMAIL_HOST_PASSWORD.
#
# SendGrid SMTP (production):
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.sendgrid.net
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=apikey
#   EMAIL_HOST_PASSWORD=<sendgrid-api-key>
#   DEFAULT_FROM_EMAIL=Sidrah Soft <noreply@sidrahsoft.com>
#
# The SendGrid API key must NEVER be committed to source control, exposed
# in frontend code, or placed in VITE_* variables. It is backend-only.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Sidrah Soft <noreply@sidrahsoft.com>
SERVER_EMAIL=

# Leads Dashboard configuration
CONTACT_NOTIFICATION_EMAIL=
LEADS_DASHBOARD_BASE_URL=

# Google Apps Script integration for training registration forms.
# Generate a long random value and paste it into the Apps Script project properties.
# PRODUCTION: This MUST be set to a strong random value (32+ characters).
DJANGO_APPS_SCRIPT_SECRET=

ALLOWED_HOSTS=localhost,127.0.0.1,192.168.142.1,192.168.1.7

# Approved local development ports: 5174-5178 (Vite auto-increments when the default port is in use).
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176,http://localhost:5177,http://127.0.0.1:5177,http://localhost:5178,http://127.0.0.1:5178

CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176,http://localhost:5177,http://127.0.0.1:5177,http://localhost:5178,http://127.0.0.1:5178